# Claves públicas: se pueden incluir en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor y scripts. Secret key actual o service_role de Supabase local.
# NUNCA uses NEXT_PUBLIC_ para esta variable.
SUPABASE_SECRET_KEY=

# Origen canónico de la app, sin barra final. Configura también Auth en Supabase.
APP_URL=http://localhost:3000

# IA: exclusivamente servidor, nunca NEXT_PUBLIC_. Sin clave hay recursos locales.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Proporcionar temporalmente para npm run auth:bootstrap; borrar después.
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_NAME=
# BOOTSTRAP_PASSWORD=

# Solo para el script de demo. Sin contraseña predeterminada.
# DEMO_PASSWORD=
